# Copy this file to ".env" at the repository root before running the apps.
#
#   cp .env.example .env
#
# All workspace applications load this single file at startup.

# Runtime
NODE_ENV=development

# Database
# Local development default matches docker-compose.yml at the repository root.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Object storage (MinIO locally, any S3-compatible service in production)
# Docker Compose starts MinIO with these credentials and creates the bucket.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=store-media
# Optional: public base URL for stored objects. Defaults to $S3_ENDPOINT/$S3_BUCKET.
# S3_PUBLIC_URL=http://localhost:9000/store-media

# Application hosts
# Base domain every application is served from.
# Development:  localhost        -> example.localhost-style hosts also work
# Production:   example.com
APP_DOMAIN=localhost

# Absolute URL of each application, used for cross-application redirects.
# Development:  storefront -> http://localhost:3000
#               admin      -> http://admin.localhost:3001
# Production:   https://example.com, https://admin.example.com
STORE_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://admin.localhost:3001

# Auth
# Secret used to sign session tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-random-32-byte-secret

# Optional: share the session cookie across subdomains in production,
# for example ".example.com". Leave unset for host-only cookies.
# AUTH_COOKIE_DOMAIN=.example.com

# Seed credentials (development only)
# SEED_ADMIN_PASSWORD=Admin123!
# SEED_CUSTOMER_PASSWORD=Customer123!
